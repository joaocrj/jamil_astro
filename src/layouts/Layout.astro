    <!-- UTM Tracker, Validação de Formulário e Modal Handler -->
    <script is:inline>
      document.addEventListener("DOMContentLoaded", function () {
        // 1. Captura de Parâmetros UTM e Origem
        function getQueryParam(param) {
          const urlParams = new URLSearchParams(window.location.search);
          return urlParams.get(param);
        }

        const utmSource = getQueryParam("utm_source");
        const utmMedium = getQueryParam("utm_medium");
        const utmCampaign = getQueryParam("utm_campaign");
        const utmTerm = getQueryParam("utm_term");
        const utmContent = getQueryParam("utm_content");

        let origem = "acesso direto";
        if (utmSource || utmMedium || utmCampaign || utmTerm || utmContent) {
          origem = "utm";
        } else if (document.referrer) {
          try {
            const ref = new URL(document.referrer);
            if (ref.hostname.includes("google") || ref.hostname.includes("bing") || ref.hostname.includes("yahoo")) {
              origem = "orgânica";
            } else {
              origem = `referência (${ref.hostname})`;
            }
          } catch (e) {
            origem = "referência";
          }
        }

        document.querySelectorAll('input[name="utm_source"]').forEach((input) => (input.value = utmSource || ""));
        document.querySelectorAll('input[name="utm_medium"]').forEach((input) => (input.value = utmMedium || ""));
        document.querySelectorAll('input[name="utm_campaign"]').forEach((input) => (input.value = utmCampaign || ""));
        document.querySelectorAll('input[name="utm_term"]').forEach((input) => (input.value = utmTerm || ""));
        document.querySelectorAll('input[name="utm_content"]').forEach((input) => (input.value = utmContent || ""));
        document.querySelectorAll('input[name="origem"]').forEach((input) => (input.value = origem));

        // 2. Menu Mobile Toggle
        const mobileMenuBars = document.querySelectorAll(".mobile_nav");
        mobileMenuBars.forEach((bar) => {
          bar.addEventListener("click", function (e) {
            e.preventDefault();
            const navMenu = bar.closest(".et_pb_menu__wrap")?.querySelector(".et-menu-nav");
            if (navMenu) {
              const isClosed = bar.classList.contains("closed");
              if (isClosed) {
                bar.classList.remove("closed");
                bar.classList.add("opened");
                navMenu.style.display = "block";
              } else {
                bar.classList.remove("opened");
                bar.classList.add("closed");
                navMenu.style.display = "none";
              }
            }
          });
        });

        // Fechar menu mobile ao clicar em um link interno
        document.querySelectorAll(".et_pb_menu__menu a").forEach((link) => {
          link.addEventListener("click", function () {
            const bar = link.closest(".et_pb_section")?.querySelector(".mobile_nav");
            const navMenu = link.closest(".et_pb_menu__wrap")?.querySelector(".et-menu-nav");
            if (bar && navMenu && window.innerWidth <= 980) {
              bar.classList.remove("opened");
              bar.classList.add("closed");
              navMenu.style.display = "none";
            }
          });
        });

        // 3. Modal Popup #popipa Handlers
        const popipaOverlay = document.getElementById("popipa-overlay");
        const closePopipaButtons = document.querySelectorAll(".popipa-close-trigger");

        function openPopipaModal() {
          if (popipaOverlay) {
            popipaOverlay.classList.add("active");
            popipaOverlay.setAttribute("aria-hidden", "false");
            document.body.style.overflow = "hidden";
          }
        }

        function closePopipaModal() {
          if (popipaOverlay) {
            popipaOverlay.classList.remove("active");
            popipaOverlay.setAttribute("aria-hidden", "true");
            document.body.style.overflow = "";
          }
        }

        // Triggers de abertura do modal
        document.querySelectorAll('[data-open-modal="popipa"], a[href="#popipa"]').forEach((btn) => {
          btn.addEventListener("click", function (e) {
            e.preventDefault();
            openPopipaModal();
          });
        });

        closePopipaButtons.forEach((btn) => {
          btn.addEventListener("click", function (e) {
            e.preventDefault();
            closePopipaModal();
          });
        });

        if (popipaOverlay) {
          popipaOverlay.addEventListener("click", function (e) {
            if (e.target === popipaOverlay) {
              closePopipaModal();
            }
          });
        }

        window.addEventListener("keydown", function (e) {
          if (e.key === "Escape" && popipaOverlay && popipaOverlay.classList.contains("active")) {
            closePopipaModal();
          }
        });

        // 4. Submissão Assíncrona do Formulário de Contato com Feedback
        const contactForms = document.querySelectorAll(".wpcf7-form");
        contactForms.forEach((form) => {
          form.addEventListener("submit", function (e) {
            e.preventDefault();

            const nomeInput = form.querySelector('input[name="seu-nome"]');
            const emailInput = form.querySelector('input[name="seu-email"]');
            const celInput = form.querySelector('input[name="seu-cel"]');
            const acceptInput = form.querySelector('input[name="acceptance-10"]');
            const submitBtn = form.querySelector('button[type="submit"]');
            const responseBox = form.querySelector(".wpcf7-response-output");

            if (!nomeInput || !emailInput || !celInput) return;

            if (!nomeInput.value.trim() || !emailInput.value.trim() || !celInput.value.trim()) {
              if (responseBox) {
                responseBox.innerText = "Por favor, preencha todos os campos obrigatórios.";
                responseBox.style.display = "block";
                responseBox.style.color = "#dc2626";
                responseBox.style.borderColor = "#dc2626";
              }
              return;
            }

            if (acceptInput && !acceptInput.checked) {
              if (responseBox) {
                responseBox.innerText = "Por favor, aceite os termos para contato.";
                responseBox.style.display = "block";
                responseBox.style.color = "#dc2626";
                responseBox.style.borderColor = "#dc2626";
              }
              return;
            }

            const formData = {
              nome: nomeInput.value.trim(),
              email: emailInput.value.trim(),
              celular: celInput.value.trim(),
              utm_source: utmSource || "",
              utm_medium: utmMedium || "",
              utm_campaign: utmCampaign || "",
              utm_term: utmTerm || "",
              utm_content: utmContent || "",
              origem: origem
            };

            const originalBtnText = submitBtn ? submitBtn.innerText : "ENVIAR";
            if (submitBtn) {
              submitBtn.disabled = true;
              submitBtn.innerText = "ENVIANDO...";
            }
            if (responseBox) {
              responseBox.innerText = "Enviando seus dados com segurança...";
              responseBox.style.display = "block";
              responseBox.style.color = "#0284c7";
              responseBox.style.borderColor = "#0284c7";
            }

            // Webhook n8n para Jamil Dentista
            fetch("https://webhook.joaocrj.com.br/webhook/joaocrj_form", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ ...formData, projeto: "Jamil Dentista" })
            })
              .then((res) => {
                if (res.ok) {
                  return res.json().catch(() => ({ status: "ok" }));
                }
                throw new Error("Falha no envio");
              })
              .then(() => {
                if (responseBox) {
                  responseBox.innerText = "Obrigado! Sua solicitação foi recebida. Entraremos em contato em breve.";
                  responseBox.style.color = "#16a34a";
                  responseBox.style.borderColor = "#16a34a";
                }
                form.reset();
              })
              .catch((err) => {
                console.warn("Erro no envio:", err);
                if (responseBox) {
                  responseBox.innerText = "Agradecemos o contato! Caso prefira, fale diretamente conosco via WhatsApp pelo botão flutuante.";
                  responseBox.style.color = "#2563eb";
                  responseBox.style.borderColor = "#2563eb";
                }
              })
              .finally(() => {
                if (submitBtn) {
                  submitBtn.disabled = false;
                  submitBtn.innerText = originalBtnText;
                }
              });
          });
        });
      });
    </script>
  </body>
