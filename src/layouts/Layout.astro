        height: 100vh;
        background: rgba(0, 0, 0, 0.75);
        backdrop-filter: blur(4px);
        z-index: 999999;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
        box-sizing: border-box;
      }
      #popipa-overlay.active {
        display: flex;
      }
      #popipa-modal-card {
        background: #ffffff;
        border-radius: 12px;
        max-width: 520px;
        width: 100%;
        max-height: 90vh;
        overflow-y: auto;
        position: relative;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.4);
        padding: 24px;
        animation: popipaFadeIn 0.3s ease-out forwards;
      }
      @keyframes popipaFadeIn {
        from {
          opacity: 0;
          transform: translateY(20px) scale(0.96);
        }
        to {
          opacity: 1;
          transform: translateY(0) scale(1);
        }
      }
      .popipa-close-btn {
        position: absolute;
        top: 12px;
        right: 14px;
        background: #f1f5f9;
        border: none;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        font-size: 20px;
        font-weight: bold;
        line-height: 1;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #334155;
        transition: all 0.2s ease;
        z-index: 10;
      }
      .popipa-close-btn:hover {
        background: #e2e8f0;
        color: #0f172a;
      }
    </style>
