---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
}

const {
  title = "Dr. Jamil Alberto Mizrahi - Dentista em Ipanema - RJ",
  description = "Clínica odontológica Dr. Jamil Alberto Mizrahi, em Ipanema. Especializado em implantes e próteses dentárias com Cirurgia Guiada, Periodontia e Endodontia.",
  image = "/images/jamil-blue.webp",
  canonicalURL = "https://jamildentista.com.br/"
} = Astro.props;

const siteUrl = "https://jamildentista.com.br";
const absoluteImageUrl = image.startsWith("http") ? image : `${siteUrl}${image.startsWith("/") ? "" : "/"}${image}`;

const schemaOrg = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["MedicalClinic", "Dentist", "LocalBusiness", "Organization"],
      "@id": "https://jamildentista.com.br/#organization",
      "name": "Dr. Jamil Alberto Mizrahi - Dentista em Ipanema - RJ",
      "url": "https://jamildentista.com.br",
      "telephone": "+55-21-98663-1972",
      "priceRange": "$$",
      "sameAs": [
        "https://www.facebook.com/jamildentista",
        "https://www.instagram.com/jamildentista/"
      ],
      "logo": {
        "@type": "ImageObject",
        "@id": "https://jamildentista.com.br/#logo",
        "url": `${siteUrl}/images/logo-3.png`,
        "contentUrl": `${siteUrl}/images/logo-3.png`,
        "caption": "Dr. Jamil Alberto Mizrahi - Dentista em Ipanema - RJ",
        "inLanguage": "pt-BR"
      },
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Rua Visconde de Pirajá, 330, Sala 1207",
        "addressLocality": "Ipanema",
        "addressRegion": "RJ",
        "postalCode": "22410-002",
        "addressCountry": "BR"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -22.9845,
        "longitude": -43.2045
      },
      "openingHours": ["Mo-Fr 09:00-17:00"],
      "image": `${siteUrl}/images/jamil-blue.webp`,
      "medicalSpecialty": [
        "Implantology",
        "Prosthodontics",
        "Periodontics",
        "Endodontics"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://jamildentista.com.br/#website",
      "url": "https://jamildentista.com.br",
      "name": "Dr. Jamil Alberto Mizrahi - Dentista em Ipanema - RJ",
      "publisher": { "@id": "https://jamildentista.com.br/#organization" },
      "inLanguage": "pt-BR"
    },
    {
      "@type": "WebPage",
      "@id": "https://jamildentista.com.br/#webpage",
      "url": canonicalURL,
      "name": title,
      "description": description,
      "isPartOf": { "@id": "https://jamildentista.com.br/#website" },
      "about": { "@id": "https://jamildentista.com.br/#organization" },
      "inLanguage": "pt-BR"
    }
  ]
};
