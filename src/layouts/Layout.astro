    <!-- UTM Tracker, Validação de Formulário e Modal Handler -->
    <script is:inline>
      document.addEventListener("DOMContentLoaded", function () {
        // 1. Captura de Parâmetros UTM e Origem
        function getQueryParam(param) {
          const urlParams = new URLSearchParams(window.location.search);
          return urlParams.get(param);
        }

        const utmSource = getQueryParam("utm_source");
        const utmMedium = getQueryParam("utm_medium");
        const utmCampaign = getQueryParam("utm_campaign");
        const utmTerm = getQueryParam("utm_term");
        const utmContent = getQueryParam("utm_content");

        let origem = "acesso direto";
        if (utmSource || utmMedium || utmCampaign || utmTerm || utmContent) {
          origem = "utm";
        } else if (document.referrer) {
          try {
            const ref = new URL(document.referrer);
            if (ref.hostname.includes("google") || ref.hostname.includes("bing") || ref.hostname.includes("yahoo")) {
              origem = "orgânica";
            } else {
              origem = `referência (${ref.hostname})`;
            }
          } catch (e) {
            origem = "referência";
          }
        }

        document.querySelectorAll('input[name="utm_source"]').forEach((input) => (input.value = utmSource || ""));
        document.querySelectorAll('input[name="utm_medium"]').forEach((input) => (input.value = utmMedium || ""));
        document.querySelectorAll('input[name="utm_campaign"]').forEach((input) => (input.value = utmCampaign || ""));
        document.querySelectorAll('input[name="utm_term"]').forEach((input) => (input.value = utmTerm || ""));
        document.querySelectorAll('input[name="utm_content"]').forEach((input) => (input.value = utmContent || ""));
        document.querySelectorAll('input[name="origem"]').forEach((input) => (input.value = origem));

        // 2. Menu Mobile Toggle
        const mobileMenuBars = document.querySelectorAll(".mobile_nav");
        mobileMenuBars.forEach((bar) => {
          bar.addEventListener("click", function (e) {
            e.preventDefault();
            const navMenu = bar.closest(".et_pb_menu__wrap")?.querySelector(".et-menu-nav");
            if (navMenu) {
              const isClosed = bar.classList.contains("closed");
              if (isClosed) {
                bar.classList.remove("closed");
                bar.classList.add("opened");
                navMenu.style.display = "block";
              } else {
                bar.classList.remove("opened");
                bar.classList.add("closed");
                navMenu.style.display = "none";
              }
            }
          });
        });

        // Fechar menu mobile ao clicar em um link interno
        document.querySelectorAll(".et_pb_menu__menu a").forEach((link) => {
          link.addEventListener("click", function () {
            const bar = link.closest(".et_pb_section")?.querySelector(".mobile_nav");
            const navMenu = link.closest(".et_pb_menu__wrap")?.querySelector(".et-menu-nav");
            if (bar && navMenu && window.innerWidth <= 980) {
              bar.classList.remove("opened");
              bar.classList.add("closed");
              navMenu.style.display = "none";
            }
          });
        });

        // 3. Modal Popup #popipa Handlers
        const popipaOverlay = document.getElementById("popipa-overlay");
        const closePopipaButtons = document.querySelectorAll(".popipa-close-trigger");
        let modalTriggered = false;
        let autoModalTimer = null;

        function openPopipaModal() {
          if (popipaOverlay && !modalTriggered) {
            modalTriggered = true;
            if (autoModalTimer) {
              clearTimeout(autoModalTimer);
              autoModalTimer = null;
            }
            window.removeEventListener("scroll", handleScrollTrigger);
            popipaOverlay.classList.add("active");
            popipaOverlay.setAttribute("aria-hidden", "false");
            document.body.style.overflow = "hidden";
          }
        }

        function closePopipaModal() {
          if (popipaOverlay) {
            popipaOverlay.classList.remove("active");
            popipaOverlay.setAttribute("aria-hidden", "true");
            document.body.style.overflow = "";
          }
        }

        // Gatilho por Scroll: ultrapassar metade da página (50%)
        function handleScrollTrigger() {
          if (modalTriggered) return;
          const scrollable = document.documentElement.scrollHeight - window.innerHeight;
          if (scrollable > 0) {
            const scrollRatio = window.scrollY / scrollable;
            if (scrollRatio >= 0.5) {
              openPopipaModal();
            }
          }
        }
        window.addEventListener("scroll", handleScrollTrigger, { passive: true });

        // Gatilho por Tempo: 8 segundos após a entrada no site
        autoModalTimer = setTimeout(function () {
          openPopipaModal();
        }, 8000);

        // Triggers de abertura do modal
        document.querySelectorAll('[data-open-modal="popipa"], a[href="#popipa"]').forEach((btn) => {
          btn.addEventListener("click", function (e) {
            e.preventDefault();
            openPopipaModal();
          });
        });

        closePopipaButtons.forEach((btn) => {
          btn.addEventListener("click", function (e) {
            e.preventDefault();
            closePopipaModal();
          });
        });

        if (popipaOverlay) {
          popipaOverlay.addEventListener("click", function (e) {
            if (e.target === popipaOverlay) {
              closePopipaModal();
            }
          });
        }

        window.addEventListener("keydown", function (e) {
          if (e.key === "Escape" && popipaOverlay && popipaOverlay.classList.contains("active")) {
            closePopipaModal();
          }
        });

        // 4. Máscara de Celular e Validações de Formulário
        function formatCellPhone(val) {
          const digits = val.replace(/\D/g, "").slice(0, 11);
          if (!digits) return "";
          if (digits.length <= 2) return "(" + digits;
          if (digits.length <= 7) return "(" + digits.slice(0, 2) + ") " + digits.slice(2);
          return "(" + digits.slice(0, 2) + ") " + digits.slice(2, 7) + " " + digits.slice(7);
        }

        const emailRegex = /^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)+$/;
        function isValidEmail(email) {
          return emailRegex.test(String(email).trim());
        }

        const contactForms = document.querySelectorAll(".wpcf7-form");
        contactForms.forEach((form) => {
          const nomeInput = form.querySelector('input[name="seu-nome"]');
          const emailInput = form.querySelector('input[name="seu-email"]');
          const celInput = form.querySelector('input[name="seu-cel"]');
          const acceptInput = form.querySelector('input[name="acceptance-10"]');
          const submitBtn = form.querySelector('button[type="submit"]');
          const responseBox = form.querySelector(".wpcf7-response-output");

          // Aplicação da Máscara de Celular: (XX) XXXXX XXXX
          if (celInput) {
            celInput.setAttribute("maxlength", "16");
            celInput.addEventListener("input", function () {
              this.value = formatCellPhone(this.value);
              this.style.borderColor = "";
            });
            celInput.addEventListener("keydown", function (e) {
              if (e.key === "Backspace") {
                const val = this.value;
                const start = this.selectionStart;
                const end = this.selectionEnd;
                if (start === end && (val[start - 1] === " " || val[start - 1] === ")")) {
                  e.preventDefault();
                  const before = val.slice(0, start - 1).replace(/\D/g, "");
                  const after = val.slice(end).replace(/\D/g, "");
                  const newDigits = before.slice(0, -1) + after;
                  this.value = formatCellPhone(newDigits);
                  const newPos = Math.max(0, start - 2);
                  this.setSelectionRange(newPos, newPos);
                }
              }
            });
            celInput.addEventListener("blur", function () {
              const digits = this.value.replace(/\D/g, "");
              if (digits.length > 0 && digits.length < 10) {
                this.style.borderColor = "#dc2626";
                if (responseBox) {
                  responseBox.innerText = "Por favor, informe o celular completo com DDD no formato (XX) XXXXX XXXX.";
                  responseBox.style.display = "block";
                  responseBox.style.color = "#dc2626";
                  responseBox.style.borderColor = "#dc2626";
                }
              }
            });
          }

          // Validação em Tempo Real no Campo de E-mail
          if (emailInput) {
            emailInput.addEventListener("input", function () {
              if (this.value.trim() && !isValidEmail(this.value)) {
                this.style.borderColor = "#dc2626";
              } else {
                this.style.borderColor = "";
                if (responseBox && responseBox.style.color === "rgb(220, 38, 38)") {
                  responseBox.style.display = "none";
                }
              }
            });
            emailInput.addEventListener("blur", function () {
              if (this.value.trim() && !isValidEmail(this.value)) {
                this.style.borderColor = "#dc2626";
                if (responseBox) {
                  responseBox.innerText = "Por favor, digite um e-mail válido (exemplo: seuemail@dominio.com).";
                  responseBox.style.display = "block";
                  responseBox.style.color = "#dc2626";
                  responseBox.style.borderColor = "#dc2626";
                }
              }
            });
          }

          // Submissão do Formulário
          form.addEventListener("submit", async function (e) {
            e.preventDefault();

            if (!nomeInput || !emailInput || !celInput) return;

            const nomeVal = nomeInput.value.trim();
            const emailVal = emailInput.value.trim();
            const celVal = celInput.value.trim();
            const celDigits = celVal.replace(/\D/g, "");

            // 1. Validação de preenchimento
            if (!nomeVal || !emailVal || !celVal) {
              if (responseBox) {
                responseBox.innerText = "Por favor, preencha todos os campos obrigatórios.";
                responseBox.style.display = "block";
                responseBox.style.color = "#dc2626";
                responseBox.style.borderColor = "#dc2626";
              }
              if (!nomeVal) nomeInput.focus();
              else if (!emailVal) emailInput.focus();
              else celInput.focus();
              return;
            }

            // 2. Validação estrita de formato de e-mail
            if (!isValidEmail(emailVal)) {
              emailInput.style.borderColor = "#dc2626";
              emailInput.focus();
              if (responseBox) {
                responseBox.innerText = "Por favor, informe um endereço de e-mail válido (exemplo: seuemail@dominio.com).";
                responseBox.style.display = "block";
                responseBox.style.color = "#dc2626";
                responseBox.style.borderColor = "#dc2626";
              }
              return;
            }

            // 3. Validação do Celular (mínimo DDD + 8 ou 9 dígitos)
            if (celDigits.length < 10) {
              celInput.style.borderColor = "#dc2626";
              celInput.focus();
              if (responseBox) {
                responseBox.innerText = "Por favor, informe um número de celular completo com DDD no formato (XX) XXXXX XXXX.";
                responseBox.style.display = "block";
                responseBox.style.color = "#dc2626";
                responseBox.style.borderColor = "#dc2626";
              }
              return;
            }

            // 4. Aceite de termos
            if (acceptInput && !acceptInput.checked) {
              if (responseBox) {
                responseBox.innerText = "Por favor, aceite os termos para autorizar o contato.";
                responseBox.style.display = "block";
                responseBox.style.color = "#dc2626";
                responseBox.style.borderColor = "#dc2626";
              }
              acceptInput.focus();
              return;
            }

            // Captura do token do Cloudflare Turnstile
            const turnstileInput = form.querySelector('[name="cf-turnstile-response"]') || document.querySelector('[name="cf-turnstile-response"]');
            let turnstileToken = turnstileInput ? turnstileInput.value : "";
            if (!turnstileToken && window.turnstile && typeof window.turnstile.getResponse === "function") {
              try {
                turnstileToken = window.turnstile.getResponse();
              } catch (e) {}
            }

            const formData = {
              nome: nomeVal,
              email: emailVal,
              celular: celVal,
              mensagem: "",
              utm_source: utmSource || "",
              utm_medium: utmMedium || "",
              utm_campaign: utmCampaign || "",
              utm_term: utmTerm || "",
              utm_content: utmContent || "",
              origem: origem || "acesso direto",
              projeto: "Jamil Dentista",
              destinatarios: ["joaocrj@gmail.com", "jamildentista1000@gmail.com"],
              turnstile_token: turnstileToken
            };

            const originalBtnText = submitBtn ? submitBtn.innerText : "ENVIAR";
            if (submitBtn) {
              submitBtn.disabled = true;
              submitBtn.innerText = "ENVIANDO...";
            }
            if (responseBox) {
              responseBox.innerText = "Enviando seus dados com segurança...";
              responseBox.style.display = "block";
              responseBox.style.color = "#0284c7";
              responseBox.style.borderColor = "#0284c7";
            }

            try {
              // 1ª tentativa: endpoint serverless da API (/api/contato)
              let sent = false;
              try {
                const apiRes = await fetch("/api/contato", {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify(formData)
                });
                if (apiRes.ok) {
                  sent = true;
                }
              } catch (e) {
                // Fallback para webhook direto
              }

              // Se a API não respondeu, envia diretamente para o webhook n8n
              if (!sent) {
                const webhookRes = await fetch("https://webhook.joaocrj.com.br/webhook/jamil_form", {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify(formData)
                });
                if (!webhookRes.ok) {
                  throw new Error("Falha no webhook: HTTP " + webhookRes.status);
                }
              }

              if (responseBox) {
                responseBox.innerText = "Obrigado! Sua mensagem foi enviada com sucesso. Entraremos em contato em breve.";
                responseBox.style.color = "#16a34a";
                responseBox.style.borderColor = "#16a34a";
              }
              form.reset();
              if (window.turnstile && typeof window.turnstile.reset === "function") {
                try {
                  window.turnstile.reset();
                } catch (tErr) {}
              }
              nomeInput.style.borderColor = "";
              emailInput.style.borderColor = "";
              celInput.style.borderColor = "";
            } catch (err) {
              console.warn("Erro no envio:", err);
              if (responseBox) {
                responseBox.innerText = "Agradecemos o contato! Caso ocorra alguma instabilidade, fale diretamente conosco pelo botão de WhatsApp.";
                responseBox.style.color = "#2563eb";
                responseBox.style.borderColor = "#2563eb";
              }
            } finally {
              if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.innerText = originalBtnText;
              }
            }
          });
        });
      });
    </script>
  </body>
</html>
