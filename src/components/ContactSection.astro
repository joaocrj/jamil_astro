---
// ContactSection.astro - Formulário de Contato e Captação de Leads
---
<div class="et_pb_section et_pb_section_12 et_pb_with_background et_section_regular">
	<div class="et_pb_row et_pb_row_18">
		<!-- Coluna Esquerda: Imagem Sucesso (Apenas Desktop) -->
		<div class="et_pb_column et_pb_column_1_2 et_pb_column_26 et_pb_css_mix_blend_mode_passthrough">
			<div class="contact-image-container">
				<img
					src="/images/sucesso.webp"
					alt="Dr. Jamil Alberto Mizrahi e paciente no consultório em Ipanema"
					width="600"
					height="800"
					loading="lazy"
					decoding="async"
					class="contact-success-img"
				/>
			</div>
		</div>

		<!-- Coluna Direita: Formulário de Contato -->
		<div class="et_pb_column et_pb_column_1_2 et_pb_column_27 et_pb_css_mix_blend_mode_passthrough et-last-child">
			<div class="et_pb_module dsm_contact_form_7 dsm_contact_form_7_0">
				<div class="et_pb_module_inner">
					<div class="dsm_contact_form_7_btn_icon" data-dsm-btn-icon="">
						<div class="wpcf7 no-js" id="wpcf7-f1795-p40-o1" lang="en-US" dir="ltr" data-wpcf7-id="1795">
							<div class="screen-reader-response"><p role="status" aria-live="polite" aria-atomic="true"></p> <ul></ul></div>
							<form action="/#wpcf7-f1795-p40-o1" method="post" class="wpcf7-form init" aria-label="Contact form" novalidate="novalidate" data-status="init">
								<!-- Texto de instrução transferido para o topo do formulário -->
								<div class="contact-form-intro">
									<p>Informe seu <strong>Nome</strong>, <strong>E-mail</strong> e <strong>Celular</strong> e entraremos em contato o quanto antes para agendarmos uma consulta para você.</p>
								</div>

								<fieldset class="hidden-fields-container">
									<input type="hidden" name="_wpcf7" value="1795">
									<input type="hidden" name="_wpcf7_version" value="6.2.3">
									<input type="hidden" name="_wpcf7_locale" value="en_US">
									<input type="hidden" name="_wpcf7_unit_tag" value="wpcf7-f1795-p40-o1">
									<input type="hidden" name="_wpcf7_container_post" value="40">
									<input type="hidden" name="_wpcf7_posted_data_hash" value="">
								</fieldset>

								<p>
									<span class="wpcf7-form-control-wrap" data-name="seu-nome">
										<input size="40" maxlength="400" class="wpcf7-form-control wpcf7-text wpcf7-validates-as-required floating-label" id="seu-nome" aria-required="true" aria-invalid="false" placeholder="Nome" value="" type="text" name="seu-nome" autocomplete="name" required>
									</span><br>
									<span class="wpcf7-form-control-wrap" data-name="seu-email">
										<input size="40" maxlength="400" class="wpcf7-form-control wpcf7-email wpcf7-validates-as-required wpcf7-text wpcf7-validates-as-email floating-label" id="seu-email" aria-required="true" aria-invalid="false" placeholder="E-mail" value="" type="email" name="seu-email" autocomplete="email" required>
									</span><br>
									<span class="wpcf7-form-control-wrap" data-name="seu-cel">
										<input size="40" maxlength="16" class="wpcf7-form-control wpcf7-tel wpcf7-validates-as-required wpcf7-text wpcf7-validates-as-tel floating-label phone" id="seu-cel" aria-required="true" aria-invalid="false" placeholder="Celular" value="" type="tel" name="seu-cel" inputmode="numeric" autocomplete="tel" required>
									</span>
								</p>

								<p>
									<button class="wpcf7-form-control wpcf7-submit has-spinner et_pb_button et_pb_bg_layout_light" id="bt-enviar" type="submit" value="ENVIAR">ENVIAR</button><br>
									<span class="wpcf7-form-control-wrap" data-name="acceptance-10">
										<span class="wpcf7-form-control wpcf7-acceptance">
											<span class="wpcf7-list-item">
												<label>
													<input type="checkbox" name="acceptance-10" value="1" id="bt-accept" aria-invalid="false">
													<span class="wpcf7-list-item-label">Eu concordo em ser contactado por Jamil Dentista.</span>
												</label>
											</span>
										</span>
									</span>
								</p>


								<input class="wpcf7-form-control wpcf7-hidden" id="utm_source" value="" type="hidden" name="utm_source">
								<input class="wpcf7-form-control wpcf7-hidden" id="utm_medium" value="" type="hidden" name="utm_medium">
								<input class="wpcf7-form-control wpcf7-hidden" id="utm_campaign" value="" type="hidden" name="utm_campaign">
								<input class="wpcf7-form-control wpcf7-hidden" id="utm_term" value="" type="hidden" name="utm_term">
								<input class="wpcf7-form-control wpcf7-hidden" id="utm_content" value="" type="hidden" name="utm_content">
								<input class="wpcf7-form-control wpcf7-hidden" id="origem" value="acesso direto" type="hidden" name="origem">
								<p style="display: none !important;" class="akismet-fields-container" data-prefix="_wpcf7_ak_">
									<label>Δ<textarea name="_wpcf7_ak_hp_textarea" cols="45" rows="8" maxlength="100"></textarea></label>
									<input type="hidden" id="ak_js_1" name="_wpcf7_ak_js" value="1793798864100">
								</p>
								<div class="wpcf7-response-output" aria-hidden="true"></div>
							</form>
						</div>
					</div>
				</div>
			</div>

			<!-- Cloudflare Turnstile -->
			<div class="turnstile-wrapper">
				<div
					class="cf-turnstile"
					data-sitekey="0x4AAAAAAF1EFGvYISJnLX8z"
					data-theme="auto"
					data-action="contato"
				></div>
			</div>
						<div class="et_pb_module et_pb_text et_pb_text_20 et_pb_text_align_left et_pb_bg_layout_light">
				<div class="et_pb_text_inner">
					<p>Este verificador serve para garantir a nossa segurança e impedir que qualquer informação fique disponível para terceiros</p>
				</div>
			</div>

			<div class="et_pb_module et_pb_text et_pb_text_21 et_clickable et_pb_text_align_center et_pb_bg_layout_light">
				<div class="et_pb_text_inner">
					<p style="text-align: center;">Política de Privacidade</p>
				</div>
			</div>
		</div>
	</div>
</div>

<style>
	.contact-image-container {
		width: 100%;
		display: flex;
		justify-content: center;
		align-items: flex-start;
		padding-top: 38px;
	}

	.contact-success-img {
		width: 100%;
		max-width: 383px;
		height: auto;
		object-fit: cover;
		border-radius: 6px;
		box-shadow: rgba(0, 0, 0, 0.2) 5px 5px 10px 0px;
		display: block;
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}

	.contact-success-img:hover {
		transform: translateY(-2px);
		box-shadow: rgba(0, 0, 0, 0.25) 5px 8px 16px 0px;
	}

	.contact-form-intro {
		margin-bottom: 22px;
		font-family: 'Montserrat', Helvetica, Arial, Lucida, sans-serif;
		color: #555555;
		font-size: 15.5px;
		line-height: 1.5;
	}

	.contact-form-intro p {
		margin: 0;
		padding: 0;
		color: #555555;
		font-size: 15.5px;
		line-height: 1.5;
	}

	.contact-form-intro strong {
		color: #222222;
		font-weight: 700;
	}

	/* Cloudflare Turnstile Widget */
	.turnstile-wrapper {
		display: flex;
		justify-content: center;
		margin: 16px 0 10px 0;
	}

	/* Ocultar a imagem na versão mobile */
	@media (max-width: 980px) {
		.contact-image-container,
		.contact-success-img,
		.et_pb_column_26 {
			display: none !important;
		}

		.contact-form-intro {
			margin-bottom: 18px;
			font-size: 14.5px;
		}
	}
</style>
